#pragma kernel CSMain

struct Vertex {
    float3 position;
    float2 uv;
    float3 normals;
};

RWStructuredBuffer<Vertex> vertexBuffer;
RWStructuredBuffer<float3> tempBuffer;

float2 _GridSize;
uint2 _GridCount;

bool _IsPinched;
uint2 _PinchPointId;
float3 _PinchPoint;
float3 _PinchRight;
float3 _PinchForward;

float _SpringWeight;
float _BendWeight;
float _ShearWeight;
float _StiffnessWeight;
float _StiffnessDumping;
float _GravityGradient;

float _DiffStep;
float _LearningStep;

bool _VertToTemp;
bool _CopyOnly;

bool _TurningForward;
bool _ResetVertices;

bool IsValidIndex(uint x, uint y)
{
    return x < _GridCount.x && y < _GridCount.y;
}

bool PinchDeform(uint3 id)
{
    uint index = id.x + id.y * _GridCount.x;

    int2 delta = id.xy - _PinchPointId;
    int2 absDelta = abs(delta);

    bool isPinchNeighbor = (delta.x == 0 && delta.y == 0) || (delta.x == 0 && absDelta.y == 1) || (delta.y == 0 && absDelta.x == 1);
    
    vertexBuffer[index].position = isPinchNeighbor ? (_PinchPoint + delta.x * _PinchRight * _GridSize.x + delta.y * _PinchForward * _GridSize.y) : vertexBuffer[index].position;
    tempBuffer[index] = isPinchNeighbor ? vertexBuffer[index].position : tempBuffer[index];

    return isPinchNeighbor;
}

float3 GetSourcePosition(uint x, uint y)
{
    if (!IsValidIndex(x, y))
        return float3(0, 0, 0);

    uint index = y * _GridCount.x + x;

    return _VertToTemp ? vertexBuffer[index].position : tempBuffer[index];
}

float3 ComputeSpringGradient(float3 pos, float3 neighbor, float originalDist) 
{
    float3 delta = pos - neighbor;
    float dist = length(delta);

    if (dist > 1e-6)
    {
        return 2 * (dist - originalDist) * (delta / dist);
    }
    return float3(0, 0, 0);
}

float3 ComputeBendGradient(float3 pos, float3 center, float3 other, float originalDist)
{
    float3 dir = normalize(other - center);
    float3 idealPos = center - originalDist * dir;
    
    float3 delta = pos - idealPos;

    return delta;
}

float3 GetPinchStiffnessTarget(uint x, uint y)
{
    int2 delta = int2(x, y) - _PinchPointId;

    return _PinchPoint + delta.x * _PinchRight * _GridSize.x + delta.y * _PinchForward * _GridSize.y;
}

float GetStiffnessWeight(uint x, uint y)
{
    int2 delta = int2(x, y) - _PinchPointId;
    float distFromPinch = length(delta);

    float pinchWeight = exp(-_StiffnessDumping * distFromPinch);

    return pinchWeight;
}

float3 ComputePinchStiffnessGradient(float3 pos, uint x, uint y)
{
    float3 target = GetPinchStiffnessTarget(x, y);
    float weight = GetStiffnessWeight(x, y);

    return (pos - target) * weight;
}

float3 ComputeGridEnergyGradient(uint x, uint y)
{
    float3 pos = GetSourcePosition(x, y);
    float3 gradient = float3(0, 0, 0);

    if (x > 0)
    {
        float3 leftPos = GetSourcePosition(x - 1, y);
        gradient += _SpringWeight * ComputeSpringGradient(pos, leftPos, _GridSize.x);
    }
    if (x < _GridCount.x - 1)
    {
        float3 rightPos = GetSourcePosition(x + 1, y);
        gradient += _SpringWeight * ComputeSpringGradient(pos, rightPos, _GridSize.x);
    }

    if (y > 0)
    {
        float3 backPos = GetSourcePosition(x, y - 1);
        gradient += _SpringWeight * ComputeSpringGradient(pos, backPos, _GridSize.y);
    }
    if (y < _GridCount.y - 1)
    {
        float3 forwardPos = GetSourcePosition(x, y + 1);
        gradient += _SpringWeight * ComputeSpringGradient(pos, forwardPos, _GridSize.y);
    }

    if (x > 1)
    {
        float3 left1 = GetSourcePosition(x - 1, y);
        float3 left2 = GetSourcePosition(x - 2, y);
        gradient += _BendWeight * ComputeBendGradient(pos, left1, left2, _GridSize.x);
    }
    if (x < _GridCount.x - 2) 
    {
        float3 right1 = GetSourcePosition(x + 1, y);
        float3 right2 = GetSourcePosition(x + 2, y);
        gradient += _BendWeight * ComputeBendGradient(pos, right1, right2, _GridSize.x);
    }

    if (y > 1)
    {
        float3 back1 = GetSourcePosition(x, y - 1);
        float3 back2 = GetSourcePosition(x, y - 2);
        gradient += _BendWeight * ComputeBendGradient(pos, back1, back2, _GridSize.y);
    }
    if (y < _GridCount.y - 2)
    {
        float3 forward1 = GetSourcePosition(x, y + 1);
        float3 forward2 = GetSourcePosition(x, y + 2);
        gradient += _BendWeight * ComputeBendGradient(pos, forward1, forward2, _GridSize.y);
    }

    float diagDist = sqrt(_GridSize.x * _GridSize.x + _GridSize.y * _GridSize.y);

    if (x > 0 && y > 0)
    {
        float3 diagPos = GetSourcePosition(x - 1, y - 1);
        gradient += _ShearWeight * ComputeSpringGradient(pos, diagPos, diagDist);
    }
    if (x < _GridCount.x - 1 && y > 0)
    {
        float3 diagPos = GetSourcePosition(x + 1, y - 1);
        gradient += _ShearWeight * ComputeSpringGradient(pos, diagPos, diagDist);
    }
    if (x > 0 && y < _GridCount.y - 1)
    {
        float3 diagPos = GetSourcePosition(x - 1, y + 1);
        gradient += _ShearWeight * ComputeSpringGradient(pos, diagPos, diagDist);
    }
    if (x < _GridCount.x - 1 && y < _GridCount.y - 1)
    {
        float3 diagPos = GetSourcePosition(x + 1, y + 1);
        gradient += _ShearWeight * ComputeSpringGradient(pos, diagPos, diagDist);
    }

    gradient += _StiffnessWeight * ComputePinchStiffnessGradient(pos, x, y);

    gradient.y += _GravityGradient;

    if (pos.y <= 1e-6 && gradient.y > 0)
    {
        gradient.y = 0;
    }

    return gradient;
}

void StepGradientDescent(uint x, uint y)
{
    uint index = y * _GridCount.x + x;
    
    float3 gradient = ComputeGridEnergyGradient(x, y);
    gradient = dot(gradient, gradient) > 1e-4 ? normalize(gradient) : float3(0, 0, 0);

    if (_VertToTemp)
    {
        float3 tempPos = vertexBuffer[index].position - gradient * _LearningStep;
        tempPos.y = max(tempPos.y, 0);
        tempBuffer[index] = tempPos;
    }
    else
    {
        float3 vertexPos = tempBuffer[index] - gradient * _LearningStep;
        vertexPos.y = max(vertexPos.y, 0);
        vertexBuffer[index].position = vertexPos;
    }
}

[numthreads(8,8,1)]
void CSMain (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= _GridCount.x || id.y >= _GridCount.y)
        return;

    uint index = id.y * _GridCount.x + id.x;

    if (id.y == 0)
    {
        vertexBuffer[index].position = float3(id.x * _GridSize.x, 0, 0);
    }

    if (_CopyOnly)
    {
        vertexBuffer[index].position = tempBuffer[index];
        return;
    }

    if (_ResetVertices)
    {
        float ySign = _TurningForward ? 1 : -1;
        vertexBuffer[index].position = float3(id.x * _GridSize.x, 0, ySign * id.y * _GridSize.y);
    }

    if (_IsPinched)
    {
        bool isPinchNeighbor = PinchDeform(id);
        if (isPinchNeighbor)
            return;
    }

    StepGradientDescent(id.x, id.y);
}